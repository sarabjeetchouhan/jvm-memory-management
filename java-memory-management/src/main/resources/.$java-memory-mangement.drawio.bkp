        <mxCell id="sdmH2Lh8s6HiHu3jjXA6-404" parent="1" style="shape=mxgraph.mockup.markup.redX;fillColor=#d80073;html=1;shadow=0;whiteSpace=wrap;strokeColor=#A50040;fontColor=#ffffff;" value="" vertex="1">
          <mxGeometry height="30" width="20" x="575" y="7150" as="geometry" />
        </mxCell>
        <mxCell id="sdmH2Lh8s6HiHu3jjXA6-406" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;ul&gt;&lt;li&gt;Now Sweep run and it will remove OB2 &amp;amp; OB4 from the memory&amp;nbsp;&lt;/li&gt;&lt;li&gt;And move all newly created &lt;b&gt;S0 with some short age&amp;nbsp;&lt;/b&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="70" width="330" x="84" y="7330" as="geometry" />
        </mxCell>
