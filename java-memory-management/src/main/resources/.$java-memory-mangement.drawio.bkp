        <mxCell id="sdmH2Lh8s6HiHu3jjXA6-235" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#b85450;fillColor=#f8cecc;align=center;verticalAlign=middle;rounded=0;" value="Static Pool" vertex="1">
