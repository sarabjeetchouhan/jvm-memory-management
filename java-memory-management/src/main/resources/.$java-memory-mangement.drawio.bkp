          <mxGeometry height="120" width="80" x="760" y="6930" as="geometry" />
        </mxCell>
        <mxCell id="sdmH2Lh8s6HiHu3jjXA6-389" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffcd28;strokeColor=#d79b00;gradientColor=#ffa500;" value="Old generation&amp;nbsp;" vertex="1">
          <mxGeometry height="120" width="240" x="840" y="6930" as="geometry" />
