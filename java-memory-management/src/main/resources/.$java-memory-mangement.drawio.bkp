          <mxGeometry height="120" width="240" x="840" y="7520" as="geometry" />
        </mxCell>
        <mxCell id="sdmH2Lh8s6HiHu3jjXA6-422" parent="1" style="ellipse;whiteSpace=wrap;html=1;shapeInside=1;aspect=fixed;fillColor=#647687;strokeColor=#314354;fontColor=#ffffff;" value="OB1" vertex="1">
          <mxGeometry height="30" width="30" x="680" y="7530" as="geometry" />
        </mxCell>
        <mxCell id="sdmH2Lh8s6HiHu3jjXA6-423" parent="1" style="ellipse;whiteSpace=wrap;html=1;shapeInside=1;aspect=fixed;fillColor=#647687;fontColor=#ffffff;strokeColor=#314354;" value="OB3" vertex="1">
