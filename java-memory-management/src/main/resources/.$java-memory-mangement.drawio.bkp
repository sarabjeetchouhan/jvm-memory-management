          <mxGeometry height="30" width="30" x="525" y="6940" as="geometry" />
        </mxCell>
        <mxCell id="sdmH2Lh8s6HiHu3jjXA6-391" parent="1" style="ellipse;whiteSpace=wrap;html=1;shapeInside=1;aspect=fixed;fillColor=#647687;strokeColor=#314354;fontColor=#ffffff;" value="OB2" vertex="1">
          <mxGeometry height="30" width="30" x="570" y="6940" as="geometry" />
        </mxCell>
        <mxCell id="sdmH2Lh8s6HiHu3jjXA6-392" parent="1" style="ellipse;whiteSpace=wrap;html=1;shapeInside=1;aspect=fixed;fillColor=#647687;fontColor=#ffffff;strokeColor=#314354;" value="OB3" vertex="1">
          <mxGeometry height="30" width="30" x="610" y="6940" as="geometry" />
