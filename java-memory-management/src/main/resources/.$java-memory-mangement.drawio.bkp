        <mxCell id="sdmH2Lh8s6HiHu3jjXA6-372" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fa6800;fontColor=#000000;strokeColor=#C73500;" value="Eden" vertex="1">
          <mxGeometry height="60" width="80" x="460" y="6670" as="geometry" />
        </mxCell>
        <mxCell id="sdmH2Lh8s6HiHu3jjXA6-378" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3c800;fontColor=#000000;strokeColor=#B09500;" value="S0" vertex="1">
          <mxGeometry height="60" width="80" x="540" y="6670" as="geometry" />
