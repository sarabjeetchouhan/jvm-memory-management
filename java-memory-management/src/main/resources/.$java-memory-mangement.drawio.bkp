        </mxCell>
        <mxCell id="sdmH2Lh8s6HiHu3jjXA6-417" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;ul&gt;&lt;li&gt;Now again we create few more new objects, let&#39;s say OB5&amp;nbsp;&lt;/li&gt;&lt;li&gt;And GC runs again, this time object will move from eden to S0 and also if S0 object age is completed then it will moved to S1&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="70" width="330" x="84" y="7540" as="geometry" />
        </mxCell>
