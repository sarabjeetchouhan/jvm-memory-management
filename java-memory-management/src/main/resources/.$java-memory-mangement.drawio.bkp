        <mxCell id="sdmH2Lh8s6HiHu3jjXA6-221" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#6c8ebf;fillColor=#dae8fc;align=center;verticalAlign=middle;rounded=0;fontStyle=1" value="Stack memory follows FIFO" vertex="1">
          <mxGeometry height="30" width="360" x="240" y="3440" as="geometry" />
        </mxCell>
        <mxCell id="sdmH2Lh8s6HiHu3jjXA6-223" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;2. Heap Memory&lt;/h1&gt;&lt;p&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Heap Memory is the core of JVM where all objects are stored.&lt;/li&gt;&lt;li&gt;Whenever an object is created using new keyword, a memory will be allocated to the object and it&#39;s memory address will be stored into the stack.&lt;/li&gt;&lt;li&gt;For String literals there will be a special memory allocated called as string pool.&lt;/li&gt;&lt;li&gt;Inside heap memory, there will be two special memory sections called as&lt;/li&gt;&lt;ul&gt;&lt;li&gt;String Pool, which will have global sope the entire jvm&lt;/li&gt;&lt;li&gt;Static Pool, which will have per class Scope&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;&lt;span&gt;&lt;b&gt;String Constant Pool&lt;/b&gt; is global because &lt;b&gt;content deduplication&lt;/b&gt; is safe and universally beneficial across all code&lt;/span&gt;&lt;span&gt;&lt;sup class=&quot;superscript&quot;&gt;&lt;/sup&gt;&lt;/span&gt;&lt;span&gt;. Also String immutable in nature which makes thread to use exact same reference.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span&gt;&lt;span&gt;&lt;b&gt;Static / Constant Pool&lt;/b&gt; is per-class because &lt;b&gt;code execution, symbolic references, and state&lt;/b&gt; require strict boundaries and isolation&lt;/span&gt;&lt;span&gt;&lt;sup class=&quot;superscript&quot;&gt;&lt;/sup&gt;&lt;/span&gt;&lt;span&gt;.&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="220" width="810" x="20" y="3520" as="geometry" />
        </mxCell>
        <mxCell id="sdmH2Lh8s6HiHu3jjXA6-224" parent="1" style="whiteSpace=wrap;html=1;aspect=fixed;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="490" width="490" x="150" y="3760" as="geometry" />
        </mxCell>
