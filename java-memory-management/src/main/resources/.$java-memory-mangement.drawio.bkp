        <mxCell id="sdmH2Lh8s6HiHu3jjXA6-379" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#6d8764;fontColor=#ffffff;strokeColor=#3A5431;" value="S1" vertex="1">
          <mxGeometry height="60" width="80" x="620" y="6670" as="geometry" />
        </mxCell>
        <mxCell id="sdmH2Lh8s6HiHu3jjXA6-380" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#647687;fontColor=#ffffff;strokeColor=#314354;" value="Old generation&amp;nbsp;" vertex="1">
          <mxGeometry height="60" width="240" x="700" y="6670" as="geometry" />
        </mxCell>
        <mxCell id="sdmH2Lh8s6HiHu3jjXA6-381" parent="1" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.annotation_2;align=left;labelPosition=right;pointerEvents=1;rotation=-90;" value="" vertex="1">
          <mxGeometry height="100" width="16" x="612" y="6708" as="geometry" />
        </mxCell>
        <mxCell id="sdmH2Lh8s6HiHu3jjXA6-382" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;b&gt;Surviving space&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="100" x="570" y="6770" as="geometry" />
        </mxCell>
        <mxCell id="sdmH2Lh8s6HiHu3jjXA6-383" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;ul&gt;&lt;li&gt;Heap Memory is&amp;nbsp; divided into 2 spaces&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;&lt;ol&gt;&lt;ol&gt;&lt;li&gt;Young Generation&amp;nbsp;&lt;/li&gt;&lt;li&gt;Old Generation&amp;nbsp;&lt;/li&gt;&lt;/ol&gt;&lt;/ol&gt;&lt;ul&gt;&lt;li&gt;In Young Generation Space, all newly created object resides with some defined age.&lt;/li&gt;&lt;li&gt;This is further divided into 3 parts,&lt;/li&gt;&lt;ul&gt;&lt;li&gt;Eden, everytime new object&lt;/li&gt;&lt;li&gt;2 Survivor Spaces&lt;/li&gt;&lt;ul&gt;&lt;li&gt;S0&lt;/li&gt;&lt;li&gt;S1&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;li&gt;In Old generation, Object will stays till it is not reachable to the application. Meaning no age is defined.&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="260" width="400" x="40" y="6480" as="geometry" />
        </mxCell>
        <mxCell id="sdmH2Lh8s6HiHu3jjXA6-384" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#82b366;fillColor=#d5e8d4;align=center;verticalAlign=middle;rounded=0;fontStyle=1;gradientColor=#97d077;" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;How GC Works&amp;nbsp;&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="410" x="340" y="6840" as="geometry" />
        </mxCell>
        <mxCell id="sdmH2Lh8s6HiHu3jjXA6-385" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;ul&gt;&lt;li&gt;When an object is created, it will first stays in Eden. Lets say we have created 4 objects as shown the figure.&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="70" width="330" x="84" y="6930" as="geometry" />
        </mxCell>
        <mxCell id="sdmH2Lh8s6HiHu3jjXA6-386" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;gradientColor=#b3b3b3;" value="Eden" vertex="1">
          <mxGeometry height="120" width="170" x="510" y="6930" as="geometry" />
        </mxCell>
