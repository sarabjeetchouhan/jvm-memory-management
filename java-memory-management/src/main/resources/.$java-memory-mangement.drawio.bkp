          <mxGeometry height="30" width="30" x="525" y="7010" as="geometry" />
        </mxCell>
        <mxCell id="sdmH2Lh8s6HiHu3jjXA6-394" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;ul&gt;&lt;li&gt;Now GC run, first mark runs and it will check which all objects are orphaned and it will for removal. Here in our case OB4 &amp;amp; OB2 are orphaned and eligible for removal&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="70" width="330" x="84" y="7160" as="geometry" />
        </mxCell>
